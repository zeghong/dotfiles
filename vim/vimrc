vim9script

# Use comma as the prefix for custom mappings
g:mapleader = ','

# Enable syntax highlighting
syntax on

# Enable filetype plugins & indent files
filetype plugin indent on

# Use true colors when Vim supports them; the colorscheme also has a
# 256-color fallback for less capable builds.
if has('termguicolors')
  set termguicolors
endif

# Load the local Nord colorscheme package.
packadd nord
colorscheme nord

# Reload unmodified files changed outside Vim
set autoread

# Use ripgrep for project search when available
if executable('rg')
  &grepprg = 'rg --vimgrep --smart-case --hidden --glob ''!.git'''
  &grepformat = '%f:%l:%c:%m'
endif

# Don't create backup files
set nowb

# Show line numbers
set number
